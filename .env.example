# Optional. A GitHub token from your own account (classic token, scope: read:user).
# With it, the "Shipping lately" total includes private contributions, matching
# what you see on your profile while logged in. Without it, the card reads your
# public profile, which counts private work only if "Private contributions" is
# enabled in your profile's contribution settings.
GITHUB_TOKEN=

# Canonical URL once you have a domain, e.g. https://hafidzasmar.dev
NEXT_PUBLIC_SITE_URL=
